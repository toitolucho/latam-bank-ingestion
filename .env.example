# Variables para docker compose en la raiz (copie a .env). La configuracion del backend va en backend/.env.
CHAT_ENV=dev
# Si el backend exige clave de integracion (CHAT_API_KEYS en backend/.env), la misma va aqui: el proxy la agrega en el servidor.
CHAT_API_KEY=
# Puerto en el que se publica la interfaz (por defecto 8080).
FRONTEND_PORT=8080
