# Se procesa con envsubst al arrancar (solo las variables definidas): BACKEND_URL y CHAT_API_KEY.
# La clave de integracion se agrega aqui, en el servidor: nunca llega al navegador.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Sin scripts ni estilos en linea; el navegador solo puede hablar con este mismo origen.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # La cola de derivaciones es de la consola del agente: nunca se expone por el proxy publico de la interfaz.
    location ^~ /v1/handoffs {
        return 404;
    }

    location /v1/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${CHAT_API_KEY}";
        proxy_set_header X-Trace-Id $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
        proxy_hide_header X-Powered-By;
    }

    location = /health {
        proxy_pass ${BACKEND_URL}/health;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }
}
